{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moray Desktop",
  "version": "0.1.0",
  "identifier": "com.moray.desktop",
  "build": {
    "beforeDevCommand": "corepack pnpm --dir ../web dev",
    "beforeBuildCommand": "corepack pnpm --dir ../web build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../web/dist"
  },
  "app": {
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    },
    "windows": [
      {
        "title": "Moray Desktop",
        "visible": false,
        "width": 1024,
        "height": 686,
        "minWidth": 900,
        "minHeight": 550,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 24
        }
      }
    ]
  },
  "bundle": {
    "active": false,
    "externalBin": ["resources/binaries/moray-cli"],
    "resources": {
      "resources/skills/": "skills/",
      "resources/tools.toml": "tools.toml",
      "resources/settings.toml": "settings.toml"
    }
  }
}
