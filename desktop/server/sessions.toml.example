# Sessions configuration (`sessions.toml`)
# Copy beside settings.toml in the Tauri app data directory (resolved by the desktop client).
#
# The file root holds session data: `default_agent_id` plus optional `[[entries]]` rows.
# Each row can override `agent_id` for that `session_id`; if omitted, resolve uses `default_agent_id`.
# More columns may be added later (transcript store, replay, streaming flags, …).
# Rows whose `agent_id` equals `default_agent_id` are omitted when the file is rewritten.
# Persisting a session’s agent via PUT …/sessions/{id}/agent requires an `[[entries]]` row for that `session_id`.
# New sessions are created via POST /sessions (catalog row + on-disk transcript).

default_agent_id = "z9y8x7w6"

# Example: an existing session with a non-default agent.
# [[entries]]
# session_id = "my-chat-tab"
# agent_id = "b2c3d4e5"
